# ---------------------------------------------------------------------------
# The Shrub Lodge — environment variables
# Copy this file to `.env.local` and fill in the keys you want to use.
# `npm run dev` must be restarted after changing these.
# ---------------------------------------------------------------------------

# --- Backend API ------------------------------------------------------------
# Public URL of the Express backend (deployed on Render). Used server-side to
# load the room list; if unset or unreachable the site falls back to the
# bundled room catalogue.
NEXT_PUBLIC_API_URL=http://localhost:5000

# Admin backend URL and shared proxy secret are server-only. Never prefix the
# proxy secret with NEXT_PUBLIC_ or include it in browser/client code.
ADMIN_API_URL=http://localhost:5000
ADMIN_API_PROXY_SECRET=

# Used only by the Next.js server to persist public contact form submissions.
CONTACT_API_PROXY_SECRET=

# --- AI assistant (Shrub Assist) -------------------------------------------
# Gemini is called server-side for natural conversation and reasoning. It does
# not browse the web; lodge-specific answers are grounded in the website content.
# Chat messages are sent to Google's Gemini API when this key is configured.
# Without it the assistant uses the built-in offline engine.
GEMINI_API_KEY=

# Optional: override the Gemini model (defaults to gemini-flash-latest, an
# alias Google keeps pointed at its newest Flash model)
GEMINI_MODEL=

# --- Contact form email delivery -------------------------------------------
# Optional email notification: Web3Forms. Messages are stored in the dashboard
# regardless; this key is used only by the server, never exposed in browser code.
WEB3FORMS_ACCESS_KEY=

# Optional email notification: Resend — create a free key at https://resend.com
# (without a verified domain you can only send to the address you signed up with)
RESEND_API_KEY=

# Optional with Resend: where enquiries are delivered (falls back to the
# reservations address in src/lib/site.ts)
CONTACT_TO_EMAIL=reservations@theshrublodge.com

# Optional with Resend: the "from" address. Must be a verified domain once you
# have one; defaults to "The Shrub Lodge Website <onboarding@resend.dev>".
CONTACT_FROM_EMAIL=

# Optional. These third-party scripts are not loaded until the matching
# analytics/marketing cookie category is accepted by the visitor.
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
NEXT_PUBLIC_META_PIXEL_ID=
